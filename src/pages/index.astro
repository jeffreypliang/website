---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import jeffrey from "../images/jeffrey.jpg";
import Section from "../components/Section.astro";
---

<Layout title="Jeffrey Liang">
  <div class="flex w-full flex-col gap-y-10">
    <section class="flex flex-col items-center gap-y-7">
      <Image
        src={jeffrey}
        alt=""
        layout="constrained"
        width={192}
        height={192}
        class="rounded-full"
        priority
      />
      <h1 class="font-sans font-semibold text-center text-3xl">
        Jeffrey Liang
      </h1>
    </section>

    <Section title="About">
      <p>
        I'm a software engineer at Databricks working on
        <a
          href="https://www.databricks.com/product/data-engineering/spark-declarative-pipelines"
          target="_blank">Spark Declarative Pipelines</a
        >.
      </p>
      <p>
        Previously, I completed two software engineering internships at Google,
        where I worked on Google Maps data infrastructure and Google Ads
        <a
          href="https://ads.google.com/intl/en_us/home/campaigns/performance-max/"
          target="_blank">Performance Max campaigns</a
        >. I graduated with a bachelor's degree in computer science from the
        University of California, Berkeley, where I also TA'd the
        <a href="https://cs186berkeley.net/" target="_blank"
          >database systems course</a
        >
        for four semesters.
      </p>
      <p>
        In my free time, I enjoy reading, listening to podcasts, solving
        puzzles, and going on long walks.
      </p>
    </Section>
    <Section title="Contact">
      <p>
        Please feel free to reach out at
        <a href="mailto:jeffreyliang@berkeley.edu">jeffreyliang@berkeley.edu</a
        >. Looking forward to talking with you!
      </p>
    </Section>
  </div>
</Layout>

<style>
  a {
    color: var(--color-blue-700);
  }

  a:hover {
    color: var(--color-blue-900);
  }
</style>
