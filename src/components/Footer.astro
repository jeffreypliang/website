---
import { execFileSync } from "node:child_process";

const lastUpdated = execFileSync(
  "git",
  ["log", "-1", "--format=%cd", "--date=format:%B %Y"],
  { encoding: "utf8" },
).trim();
---

<footer
  class="mt-auto w-full max-w-[60rem] px-10 pt-10 pb-5 text-center text-sm"
>
  Last updated {lastUpdated}.
</footer>
